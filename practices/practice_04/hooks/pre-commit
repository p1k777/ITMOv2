#!/usr/bin/env bash
# Pre-commit wrapper for practice_04. Runs only on specific branch and paths.

set -euo pipefail

TARGET_BRANCH="pr_4_kondratyev"
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"

if [ "$CURRENT_BRANCH" != "$TARGET_BRANCH" ]; then
  # Skip on other branches
  exit 0
fi

# Limit to changes under practices/practice_04/
CHANGED_FILES=$(git diff --cached --name-only | grep '^practices/practice_04/' || true)
if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

# Run linter
python3 practices/practice_04/tools/lint.py

# Run tests (quiet) if pytest is available
if python3 - <<'PY'
import importlib
import sys
try:
    importlib.import_module('pytest')
except Exception:
    sys.exit(1)
PY
then
  python3 -m pytest -q
else
  echo "pre-commit: skip tests (pytest not installed)"
fi
